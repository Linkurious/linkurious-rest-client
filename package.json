{
  "name": "@linkurious/rest-client",
  "version": "4.3.5",
  "description": "A library to interact with Linkurious Enterprise's API",
  "files": [
    "dist/index.mjs",
    "dist/index.mjs.map",
    "dist/src/**/*.d.ts"
  ],
  "main": "./dist/index.mjs",
  "types": "./dist/src/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Linkurious/linkurious-rest-client.git"
  },
  "author": "Linkurious",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Linkurious/linkurious-rest-client/issues"
  },
  "engines": {
    "node": "24.14.1"
  },
  "homepage": "https://github.com/Linkurious/linkurious-rest-client#readme",
  "scripts": {
    "build": "tsc && esbuild --bundle --sourcemap --target=es2020 --format=esm --outfile=dist/index.mjs src/index.ts",
    "test": "mocha dist/test",
    "test:unit": "mocha --reporter mocha-multi-reporters --reporter-options configFile=.test-reporters.json dist/test",
    "coverage": "nyc --reporter=text-summary --reporter=cobertura --report-dir=reports  mocha --reporter mocha-multi-reporters --reporter-options configFile=.test-reporters.json dist/test",
    "compile": "tsc",
    "tsc": "tsc",
    "lint": "eslint --fix --ext .ts .",
    "lint:ci": "eslint --cache --cache-strategy content -f checkstyle -o reports/checkstyle.xml --ext .ts .",
    "watch": "tsc -w | tee",
    "clean": "rm -rf node_modules dist reports .eslintcache .nyc_output",
    "bump:patch": "bump2version patch && npm version --no-git-tag-version patch",
    "bump:minor": "bump2version minor && npm version --no-git-tag-version minor",
    "bump:major": "bump2version major && npm version --no-git-tag-version --no-commit-hooks --no-workspaces-update major"
  },
  "devDependencies": {
    "@types/express": "4.17.15",
    "@types/mocha": "10.0.6",
    "@types/node": "24.12.0",
    "@typescript-eslint/eslint-plugin": "7.15.0",
    "@typescript-eslint/parser": "7.15.0",
    "esbuild": "0.28.0",
    "eslint": "8.57.0",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-es5": "1.5.0",
    "eslint-plugin-import": "2.29.0",
    "eslint-plugin-prettier": "5.0.1",
    "fetch-cookie": "3.2.0",
    "mocha": "10.2.0",
    "mocha-junit-reporter": "2.2.1",
    "mocha-multi-reporters": "1.5.1",
    "nyc": "15.1.0",
    "prettier": "3.1.1",
    "typescript": "5.5.4"
  },
  "publishConfig": {
    "access": "public"
  }
}
